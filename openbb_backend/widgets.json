        "value": "RELIANCE",
        "description": "Search for a stock symbol"
      },
      {
        "paramName": "time_period",
        "label": "Time Period",
        "type": "text",
        "options": [
          { "label": "1M", "value": "1M" },
          { "label": "3M", "value": "3M" },
          { "label": "6M", "value": "6M" },
          { "label": "YTD", "value": "YTD" },
          { "label": "1Y", "value": "1Y" },
          { "label": "3Y", "value": "3Y" },
          { "label": "5Y", "value": "5Y" },
          { "label": "LTD", "value": "LTD" }
        ],
        "value": "1Y",
        "description": "Select time period for chart"
      }
    ]
  },




  "annual_reports": {
    "name": "Financial Statements",
    "description": "Annual P&L, Cash Flow, Balance Sheet",
    "category": "Portfolio",
    "subCategory": "stocks",
    "type": "table",
    "endpoint": "stocks/financial_reports",
    "gridData": { "w": 36, "h": 28 },
    "columnsDefs": [
      { "field": "year", "headerName": "Year", "pinned": "left", "cellDataType": "text" }
    ],
    "params": [
      {
        "paramName": "symbol",
        "label": "Symbol",
        "type": "endpoint",
        "optionsEndpoint": "stock/search",
        "optionsParams": { "query": "" },
        "enableSearch": true,
        "value": "RELIANCE",
        "description": "Search for a stock symbol"
      },
      {
        "paramName": "statement",
        "label": "Statement",
        "type": "text",
        "options": [
          { "label": "Profit & Loss", "value": "pnl" },
          { "label": "Cash Flow",     "value": "cash_flow" },
          { "label": "Balance Sheet", "value": "balance_sheet" }
        ],
        "value": "pnl",
        "description": "Select financial statement"
      }
    ]
  },


  "stock_holding": {
